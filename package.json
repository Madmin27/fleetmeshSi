    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "codemirror": "6.0.2",
    "esbuild": "0.28.2",
    "html-validate": "9.7.1",
    "jsdom": "26.1.0",
    "jsonc-parser": "3.3.1",
    "lighthouse": "12.8.2",
    "lucide": "1.53.0",
    "playwright": "1.58.2"
  },
