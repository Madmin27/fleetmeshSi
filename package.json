    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "vendor": "node scripts/vendor-massrobotics.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
