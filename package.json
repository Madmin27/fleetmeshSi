{
  "name": "fleetmesh-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/vendor-massrobotics.mjs && node scripts/build.mjs",
    "lint": "node --check scripts/build.mjs && node --check src/pages.mjs && node --check scripts/check.mjs && html-validate 'dist/**/*.html'",
